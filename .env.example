# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Meta Ad Library API
META_AD_LIBRARY_ACCESS_TOKEN=

# Meta Login for Business (Ad Performance Tracker)
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=

# OpenAI (Creative Generator — image generation; Claude has no image-gen model)
OPENAI_API_KEY=

# Shopify (Creative Generator reference-image allowlist). Optional — only needed if your
# store serves CDN images from a custom domain (e.g. yourstore.com/cdn/shop/...) rather
# than cdn.shopify.com/*.myshopify.com.
SHOPIFY_STORE_HOSTNAME=
